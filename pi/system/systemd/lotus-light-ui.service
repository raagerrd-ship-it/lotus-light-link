[Unit]
Description=lotus-light ui service
After=network.target

[Service]
MemoryMax=224M
Type=simple
User=pi
Group=pi
WorkingDirectory=/opt/lotus-light
ExecStart=/usr/bin/python3 /home/pi/pi-control-center/public/pi-scripts/static-spa-server.py --root /opt/lotus-light/dist/ --port 3001 --host 0.0.0.0
Environment=NPM_CONFIG_CACHE=/opt/lotus-light/.npm-cache
Environment=PCC_APP_KEY=lotus-light
Environment=PCC_CONFIG_DIR=/etc/pi-control-center/apps/lotus-light
Environment=PCC_DATA_DIR=/var/lib/pi-control-center/apps/lotus-light
Environment=PCC_LOG_DIR=/var/log/pi-control-center/apps/lotus-light
Environment=PCC_PERMISSIONS=bluetooth,audio,rfkill
Environment=PORT=3001
Environment=ENGINE_PORT=3051
Environment=UI_PORT=3001
Environment=HOME=/var/lib/pi-control-center/apps/lotus-light/home
Environment=XDG_DATA_HOME=/var/lib/pi-control-center/apps/lotus-light/home/.local/share
CPUAffinity=0
AllowedCPUs=0

ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/lotus-light
ReadWritePaths=/etc/pi-control-center/apps/lotus-light
ReadWritePaths=/var/lib/pi-control-center/apps/lotus-light
ReadWritePaths=/var/log/pi-control-center/apps/lotus-light
PrivateTmp=true
SupplementaryGroups=netdev bluetooth audio

StandardOutput=append:/var/log/pi-control-center/apps/lotus-light/ui.log
StandardError=append:/var/log/pi-control-center/apps/lotus-light/ui.log
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
