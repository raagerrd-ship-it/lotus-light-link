[Unit]
Description=lotus-light engine service
After=network.target

[Service]
MemoryMax=224M
Type=simple
User=pi
Group=pi
WorkingDirectory=/opt/lotus-light/pi
ExecStart=/usr/bin/node --max-old-space-size=224 /opt/lotus-light/pi/dist/index.js
Environment=NPM_CONFIG_CACHE=/opt/lotus-light/.npm-cache
Environment=PCC_APP_KEY=lotus-light
Environment=PCC_CONFIG_DIR=/etc/pi-control-center/apps/lotus-light
Environment=PCC_DATA_DIR=/var/lib/pi-control-center/apps/lotus-light
Environment=PCC_LOG_DIR=/var/log/pi-control-center/apps/lotus-light
Environment=PCC_PERMISSIONS=bluetooth,audio,rfkill
Environment=PORT=3051
Environment=ENGINE_PORT=3051
Environment=UI_PORT=3001
Environment=HOME=/var/lib/pi-control-center/apps/lotus-light/home
Environment=XDG_DATA_HOME=/var/lib/pi-control-center/apps/lotus-light/home/.local/share
Environment=NODE_ENV=production
Environment=NODE_OPTIONS=--max-old-space-size=224
Environment=DBUS_SYSTEM_BUS_ADDRESS=unix:path=/run/dbus/system_bus_socket
CPUAffinity=1
AllowedCPUs=1
NoNewPrivileges=false
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN CAP_SYS_NICE
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN CAP_SYS_NICE
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/lotus-light
ReadWritePaths=/etc/pi-control-center/apps/lotus-light
ReadWritePaths=/var/lib/pi-control-center/apps/lotus-light
ReadWritePaths=/var/log/pi-control-center/apps/lotus-light
PrivateTmp=true
SupplementaryGroups=netdev bluetooth audio
DeviceAllow=/dev/rfkill rw
DeviceAllow=char-rfkill rw
DeviceAllow=char-alsa rw
DeviceAllow=/dev/snd rw
LimitRTPRIO=99
LimitNICE=-20
StandardOutput=append:/var/log/pi-control-center/apps/lotus-light/engine.log
StandardError=append:/var/log/pi-control-center/apps/lotus-light/engine.log
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
