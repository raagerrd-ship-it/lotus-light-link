[Unit]
Description=Lotus Light Link — BLE LED Engine
After=bluetooth.target
Wants=bluetooth.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/opt/lotus-light/pi

# CPU affinity — same core as the rest of the pipeline
# Overridden by setup-lotus.sh via systemctl set-property
CPUAffinity=1

# BLE via noble needs raw HCI — these capabilities replace setcap on the binary.
# AmbientCapabilities + NoNewPrivileges=false is what makes this work
# (PCC's sandbox sets NoNewPrivileges=true which kills capabilities).
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN
NoNewPrivileges=false

# Nice priority — not real-time, but higher than default
Nice=-5

# Environment
Environment=NODE_ENV=production
Environment=PORT=3050

ExecStart=/usr/bin/node /opt/lotus-light/pi/dist/index.js

# Auto-restart on crash
Restart=always
RestartSec=2

# Resource limits
MemoryMax=128M
LimitNOFILE=4096

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=lotus-light

[Install]
WantedBy=multi-user.target